<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hijau_latar">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container untuk fullscreen scan -->
    <FrameLayout
        android:id="@+id/scan_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="40dp" />

    <!-- Glass Bottom Nav Container -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Glass background card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            app:cardCornerRadius="34dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#EDFFFFFF"
            app:strokeWidth="0dp"
            app:cardMaxElevation="12dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:itemIconTint="@color/nav_item_selector"
                app:itemTextColor="@color/nav_item_selector"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/bottom_nav_menu"
                app:elevation="0dp"
                app:itemIconSize="24dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- FAB Camera Button (menonjol ke atas di tengah) -->
        <FrameLayout
            android:id="@+id/fab_scan"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="-8dp"
            android:background="@drawable/bg_fab_camera"
            android:elevation="13dp"
            android:outlineAmbientShadowColor="@android:color/transparent"
            android:outlineSpotShadowColor="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera_filled"
                app:tint="@color/putih" />

        </FrameLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
