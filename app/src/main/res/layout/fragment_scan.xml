<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ LAYER 1: Kamera Fullscreen ═══ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ LAYER 2: Pratinjau setelah foto diambil ═══ -->
    <ImageView
        android:id="@+id/imgPratinjau"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ LAYER 2b: Live Classification Overlay ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLiveOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_live_overlay"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutAksi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- LIVE badge -->
        <TextView
            android:id="@+id/tvLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_kategori"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="● LIVE"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Label nama penyakit -->
        <TextView
            android:id="@+id/tvLiveLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Mendeteksi..."
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLiveBadge" />

        <!-- Confidence value text -->
        <TextView
            android:id="@+id/tvLiveKonfiden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0%"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLiveLabel" />

        <!-- Confidence progress bar -->
        <ProgressBar
            android:id="@+id/pbLiveKonfiden"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_live_confidence_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvLiveKonfiden"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLiveLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══ LAYER 3: Vignette atas (fade hitam) ═══ -->
    <View
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/gradient_atas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ LAYER 4: Vignette bawah (fade hitam) ═══ -->
    <View
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@drawable/gradient_bawah"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ═══ TOP BAR: Tombol kembali + Judul ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol kembali – pill transparan -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnKembali"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/putih" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Judul di tengah -->
        <TextView
            android:id="@+id/tvJudulScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Pindai Daun"
            android:textColor="@color/putih"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:layout_constraintBottom_toBottomOf="@id/btnKembali"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnKembali"
            app:layout_constraintTop_toTopOf="@id/btnKembali" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══ AREA BIDIK: Corner frame elegan ═══ -->
    <ImageView
        android:id="@+id/targetBidik"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:src="@drawable/ic_scan_frame"
        android:scaleType="fitCenter"
        android:alpha="0.85"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38" />

    <!-- Label panduan di bawah frame bidik -->
    <TextView
        android:id="@+id/tvPanduanBidik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Posisikan daun dalam bingkai"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/targetBidik" />

    <!-- ═══ KARTU HASIL ANALISIS ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHasil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="140dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F8FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#1A4CAF7D"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <!-- Baris atas: badge + ikon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTagHasil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_kategori"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="HASIL ANALISIS"
                    android:textColor="@color/putih"
                    android:textSize="10sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_daun_labu"
                    app:tint="@color/hijau_primer" />
            </LinearLayout>

            <!-- Divider tipis -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0F000000"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Label hasil -->
            <TextView
                android:id="@+id/tvLabelHasil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menganalisa..."
                android:textColor="@color/teks_gelap"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <!-- Skor akurasi -->
            <TextView
                android:id="@+id/tvSkorHasil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/teks_sekunder"
                android:textSize="13sp" />

            <!-- Mitigasi -->
            <TextView
                android:id="@+id/tvMitigasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/teks_sekunder"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- Tombol tutup -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTutupHasil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Selesai"
                android:textColor="@color/putih"
                android:textSize="14sp"
                android:letterSpacing="0.02"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/hijau_primer"
                app:elevation="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ PANEL AKSI BAWAH: Galeri + Potret ═══ -->
    <LinearLayout
        android:id="@+id/layoutAksi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tombol Galeri -->
        <LinearLayout
            android:id="@+id/btnGaleriContainer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_ikon_putih_alpha"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/btnGaleri"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_gallery"
                app:tint="@color/putih" />
        </LinearLayout>

        <!-- Tombol Potret utama -->
        <LinearLayout
            android:id="@+id/btnPotretContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bg_tombol_kamera_utama"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp">
            <ImageView
                android:id="@+id/btnPotret"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_camera_filled"
                app:tint="@color/putih" />
        </LinearLayout>

        <!-- Spacer kanan agar tombol galeri-potret simetris -->
        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="28dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
