<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRiwayat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/abu_garis"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Thumbnail + Overlay Seleksi -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_img_corner_kiri"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/imgRiwayat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:minHeight="80dp"
                android:background="@color/abu_kartu" />

            <!-- Overlay gelap saat item dipilih -->
            <View
                android:id="@+id/overlaySeleksi"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CC1C3D2B"
                android:visibility="gone" />

            <!-- Checkbox centang di tengah -->
            <CheckBox
                android:id="@+id/checkboxSeleksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="false"
                android:focusable="false"
                android:buttonTint="@color/putih"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Konten Teks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvKategoriRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_kategori"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="SEHAT"
                android:textColor="@color/putih"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvHasilRiwayat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Daun Sehat"
                android:textColor="@color/teks_gelap"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSkorRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Akurasi: 98%"
                android:textColor="@color/aksen_peach"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWaktuRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="16 Apr 2026 • 14:32"
                android:textColor="@color/teks_redup"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Tombol Hapus (sembunyi di mode seleksi) -->
        <ImageView
            android:id="@+id/btnHapus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/merah_penyakit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Strip warna kanan -->
        <View
            android:id="@+id/stripKiri"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/hijau_primer" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
