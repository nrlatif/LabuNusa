<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hijau_latar">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerInformasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header_beranda"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="56dp">

        <!-- Label atas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan Petani"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Informasi Penyakit"
            android:textColor="@color/putih"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ketuk kartu untuk melihat gejala &amp; cara mitigasi"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tanggal_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="DAUN LABU"
            android:textColor="#EEFFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RecyclerView Kartu Informasi (dengan latar melengkung) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInformasi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerInformasi"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="-32dp"
        android:background="@drawable/bg_content_rounded"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="140dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</RelativeLayout>
