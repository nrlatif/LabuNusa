<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cincin Luar Putih Solid (Lebar dan Kontras Maksimal) -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="5dp" android:color="#FFFFFF"/>
            <solid android:color="#66FFFFFF"/>
        </shape>
    </item>
    <!-- Lingkaran Dalam Hijau Solid (Kuat & Jelas) -->
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/hijau_primer"/>
        </shape>
    </item>
</layer-list>
